# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
# tsc --noEmit 在 incremental 模式下会留下这个文件
tsconfig.tsbuildinfo
# 本地临时截图（验证页面时用）
.tmp-*.png
# Playwright MCP 驱动浏览器验证时落在 cwd 的截图与快照
/.playwright-mcp/
# 中文提交信息走 git commit -F，避免 PowerShell 引号/反斜杠问题。
# 这个文件曾被误提交进仓库一次，所以连文本一起忽略。
.tmp-*.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*
!.env.example

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
# deploy.mjs 打好的上传包
/xwsx-standalone.tar.gz

# font build intermediates (regenerate with subset-fonts.py, see split-fonts.py)
/fonts-src/

# image masters (regenerate outputs with npm run portrait / npm run images;
# 恢复母版见 scripts/optimize-portrait.py 头部的 git cat-file 命令)
/images-src/
.mimosa/
