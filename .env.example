# Replace with the final public Site or custom-domain origin before deployment.
# Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ── 站内 AI 问答（可选；两边都不配则功能整体关闭）────────────────
# 默认指向硅基流动（chat 与 embedding 的免费档都够用）。
# 注意：Qwen3 系是推理模型，请求已带 enable_thinking:false（见 app/api/ask/route.ts），
# 换其它 OpenAI 兼容服务时保留该参数即可（非推理模型会忽略它）。换智谱示例：
#   ASK_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   ASK_LLM_MODEL=glm-4-flash
#   ASK_EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   ASK_EMBED_MODEL=embedding-3
# 构建期（prebuild）读 EMBED 三个变量生成向量索引；
# 运行期（服务器 systemd 环境，/home/xwsx/xwsx-site/ask.env）读 LLM 三个变量回答问题。
ASK_LLM_BASE_URL=https://api.siliconflow.cn/v1
ASK_LLM_API_KEY=
ASK_LLM_MODEL=Qwen/Qwen3.5-35B-A3B
ASK_EMBED_BASE_URL=https://api.siliconflow.cn/v1
ASK_EMBED_API_KEY=
ASK_EMBED_MODEL=BAAI/bge-m3
