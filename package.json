{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "check": "npm run check:css && npm run check:glyphs",
    "check:css": "node --experimental-strip-types scripts/check-css-integrity.ts",
    "check:glyphs": "node --experimental-strip-types scripts/check-glyph-coverage.ts",
    "build": "node scripts/clean-dist.mjs && npm run check && vinext build",
    "postbuild": "node scripts/fix-standalone.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "og": "node --experimental-strip-types scripts/generate-og.ts",
    "fonts": "python split-fonts.py",
    "images": "python scripts/optimize-pup-images.py",
    "deploy": "node scripts/deploy.mjs",
    "portrait": "python scripts/optimize-portrait.py"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "marked": "^18.0.11",
    "prismjs": "^1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "lighthouse": "^13.4.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "satori": "^0.33.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
